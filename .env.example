# Main reasoning model on AWS Bedrock. Use a model enabled in your account.
# Current Claude models use short IDs and Bedrock's Messages API (bedrock-mantle):
LHA_BEDROCK_MODEL_ID=anthropic.claude-sonnet-5
# Optional thinking depth per step: low | medium | high | xhigh | max (unset = API default)
# LHA_EFFORT=medium
# Versioned IDs ending in "-v1:0" go through the Converse API instead and need a
# cross-region inference profile prefix (us./eu./apac.), e.g.
# LHA_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_REGION=us-east-1

# Cheap compaction/summarization model: Liquid AI LFM behind any OpenAI-compatible endpoint
# (Liquid's API, vLLM, llama.cpp server, Ollama ...). Also usable as the main model.
LHA_LIQUID_BASE_URL=
LHA_LIQUID_MODEL=LFM2-1.2B
LHA_LIQUID_API_KEY=

# Nimble web data (web_search / web_fetch tools). "user:password" or base64 token.
NIMBLE_CREDENTIALS=
# LHA_NIMBLE_BASE_URL=https://api.webit.live/api/v1/realtime

# Tinybird telemetry (Events API). Push tinybird/ with the tb CLI first.
TINYBIRD_TOKEN=
TINYBIRD_HOST=https://api.tinybird.co
