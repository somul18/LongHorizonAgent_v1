# Main reasoning model on AWS Bedrock (Converse API). Use a model ID enabled in your account.
LHA_BEDROCK_MODEL_ID=
AWS_REGION=us-east-1

# Cheap compaction/summarization model: Liquid AI LFM behind any OpenAI-compatible endpoint
# (Liquid's API, vLLM, llama.cpp server, Ollama ...). Also usable as the main model.
LHA_LIQUID_BASE_URL=
LHA_LIQUID_MODEL=LFM2-1.2B
LHA_LIQUID_API_KEY=

# Nimble web data (web_search / web_fetch tools). "user:password" or base64 token.
NIMBLE_CREDENTIALS=
# LHA_NIMBLE_BASE_URL=https://api.webit.live/api/v1/realtime

# Tinybird telemetry (Events API). Push tinybird/ with the tb CLI first.
TINYBIRD_TOKEN=
TINYBIRD_HOST=https://api.tinybird.co
