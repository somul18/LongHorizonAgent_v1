# Copy to .env, fill in, then load into a terminal with:   set -a; source .env; set +a
# .env is git-ignored. Never commit real keys.

# ---------------------------------------------------------------- AWS Bedrock (main model)
# Check which models your account can call:   python -m lha.cli models
#
# Versioned IDs ending in "-v1:0" go through Bedrock's Converse API and need a cross-region
# inference profile prefix (us. / eu. / apac.):
LHA_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Current Claude models use short IDs and Bedrock's Messages API (bedrock-mantle), if your
# account has them enabled:
# LHA_BEDROCK_MODEL_ID=anthropic.claude-sonnet-5
AWS_REGION=us-east-1

# Credentials: leave these out if they are in ~/.aws/credentials (aws configure) or AWS_PROFILE.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional: seconds before a Bedrock call is abandoned (default 60; one retry)
# LHA_LLM_TIMEOUT=60
# Optional, short-ID (Messages API) models only: thinking depth low | medium | high | xhigh | max
# LHA_EFFORT=medium

# ---------------------------------------------------------------- Liquid AI (memory model, optional)
# Small LFM behind any OpenAI-compatible endpoint (Liquid's API, vLLM, llama.cpp, Ollama).
# Writes one-line digests when finished tasks are compacted. Also usable as the main model.
# LHA_LIQUID_BASE_URL=
# LHA_LIQUID_MODEL=LFM2-1.2B
# LHA_LIQUID_API_KEY=

# ---------------------------------------------------------------- Nimble (web tools, optional)
# "user:password" or a pre-encoded token. Enables web_search / web_fetch in `lha.cli run`.
# NIMBLE_CREDENTIALS=
# LHA_NIMBLE_BASE_URL=https://api.webit.live/api/v1/realtime

# ---------------------------------------------------------------- Tinybird (telemetry, optional)
# Deploy tinybird/ with the tb CLI first.
# TINYBIRD_TOKEN=
# TINYBIRD_HOST=https://api.tinybird.co
